// use prisma-next

model AuthUser {
  id        String   @id @default(uuid())
  email     String   @unique
  role      String   @default("USER")
  provider       String
  providerUserId String 

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([provider, providerUserId])
}
