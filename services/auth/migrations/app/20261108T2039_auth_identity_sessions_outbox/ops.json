    "execute": [
      {
        "description": "create table \"auth_identities\"",
        "sql": "CREATE TABLE \"public\".\"auth_identities\" (\n  \"created_at\" timestamptz DEFAULT (now()) NOT NULL,\n  \"email\" text,\n  \"password_hash\" text,\n  \"status\" text DEFAULT 'PENDING' NOT NULL,\n  \"updated_at\" timestamptz NOT NULL,\n  \"user_id\" uuid NOT NULL,\n  PRIMARY KEY (\"user_id\"),\n  CONSTRAINT \"auth_identities_compensated_credentials_check_a078c01e\" CHECK ((status = 'COMPENSATED' AND email IS NULL AND password_hash IS NULL) OR (status <> 'COMPENSATED' AND email IS NOT NULL)),\n  CONSTRAINT \"auth_identities_status_check_3b7c904d\" CHECK (\"status\" IN ('PENDING', 'PROFILE_CREATING', 'ACTIVE', 'COMPENSATING', 'COMPENSATED', 'DISABLED'))\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"auth_identities\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"auth_identities\""
        ]
      }
    ]
