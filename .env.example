# Local example only. Copy to .env to override. Do not commit .env.
# Local runtime only. Never use these values in a deployed environment.
# One compose file: docker-compose.yml. Auth reads DATABASE_URL.
# That URL is the postgres service from decision 0006, port 5432, database kinvue.
# AUTH_DATABASE_URL names the same database. There is no second auth Postgres.

NODE_ENV=development

DATABASE_URL=postgresql://kinvue:kinvue@localhost:5432/kinvue
AUTH_DATABASE_URL=postgresql://kinvue:kinvue@localhost:5432/kinvue
GOOGLE_CLIENT_ID=replace-with-local-google-client-id
JWT_ACCESS_SECRET=local-dev-access-secret-change-me
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me
AUTH_HTTP_PORT=4001
AUTH_HTTP_HOST=127.0.0.1
AUTH_GRPC_URL=0.0.0.0:50051

MOVIE_POSTGRES_USER=kinvue_movie
MOVIE_POSTGRES_PASSWORD=kinvue_movie
MOVIE_POSTGRES_DB=kinvue_movie
MOVIE_DATABASE_URL=postgresql://kinvue_movie:kinvue_movie@localhost:5434/kinvue_movie

USERS_MONGO_URL=mongodb://localhost:27017/kinvue_users

REDIS_URL=redis://localhost:6379
ROOMS_HTTP_PORT=4004
ROOMS_HTTP_HOST=127.0.0.1
ROOMS_WS_PORT=4014

RABBITMQ_USER=kinvue
RABBITMQ_PASSWORD=kinvue
RABBITMQ_URL=amqp://kinvue:kinvue@localhost:5672

MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=dev-master-key-change-me

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=kinvue
S3_SECRET_KEY=kinvue-secret
S3_BUCKET=kinvue-media

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

JWT_ISSUER=kinvue-auth
JWT_AUDIENCE=kinvue
# Plan default, not the value the auth service uses today.
ACCESS_TOKEN_TTL_SECONDS=900
# Plan default. Code still uses 7 days until a decision says otherwise.
REFRESH_TOKEN_TTL_DAYS=30
# Plan default. No media-url code reads this yet.
MEDIA_URL_TTL_SECONDS=600
